{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": { "includes": ["src/**", "tests/**", "tools/**", "!tests/fixtures/**"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "error", "noControlCharactersInRegex": "off" },
      "style": { "noNonNullAssertion": "off" },
      "complexity": { "useLiteralKeys": "off" }
    }
  }
}
